# Copy to .env for local development (never commit .env). On Vercel, set these
# in Project -> Settings -> Environment Variables instead.

# --- Required ---------------------------------------------------------------

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Neon connection string (Neon dashboard -> Connect). Use the POOLED string
# (host contains "-pooler") on Vercel. Either postgres:// or postgresql:// works.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# The Vercel <-> Neon integration sets DATABASE_URL / POSTGRES_URL for you.
DATABASE_URL=

# --- Optional ---------------------------------------------------------------

# First-run admin. If set and no admin exists, one is created at startup.
# Remove both once you have signed in.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Force the Secure cookie flag outside Vercel (Vercel sets it automatically).
HTTPS_ONLY=0

# Local dev only.
PORT=5000
FLASK_DEBUG=0
